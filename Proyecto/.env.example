# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas tu archivo ".env" real a GitHub.

SECRET_KEY=cambia-esta-clave-por-una-generada-y-secreta
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# DB_ENGINE=sqlite3 para desarrollo local
# DB_ENGINE=mysql para producción (EC2 + phpMyAdmin)
DB_ENGINE=sqlite3
DB_NAME=nombre_basedatos
DB_USER=usuario_bd
DB_PASSWORD=clave_bd
DB_HOST=localhost
DB_PORT=3306
